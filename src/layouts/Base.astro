---
import '../styles/global.css';
import personSchema from '../data/person-schema.json';
import { SITE, NAV, THIRD_PARTY, url } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Path (without base) used for the canonical URL and nav highlighting. */
  path: string;
  image?: string;
}
const { title, description = SITE.description, path, image } = Astro.props;
const canonical = new URL(url(path), Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sanchez&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <slot name="head" />
  {THIRD_PARTY && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
      <script is:inline define:vars={{ id: SITE.ga4Id }}>
        window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date()); gtag('config', id);
      </script>
      <script src={`https://app.bentonow.com/${SITE.bentoSiteKey}.js`} defer async></script>
      <script is:inline>window.addEventListener('bento:ready', function(){ if (typeof bento$ !== 'undefined') bento$(function(){ bento.view(); }); });</script>
      <script is:inline define:vars={{ appId: SITE.intercomAppId }}>
        window.intercomSettings = { api_base: 'https://api-iam.intercom.io', app_id: appId };
        (function(){var w=window;var ic=w.Intercom;if(typeof ic==="function"){ic('reattach_activator');ic('update',w.intercomSettings);}else{var d=document;var i=function(){i.c(arguments);};i.q=[];i.c=function(args){i.q.push(args);};w.Intercom=i;var l=function(){var s=d.createElement('script');s.type='text/javascript';s.async=true;s.src='https://widget.intercom.io/widget/'+appId;var x=d.getElementsByTagName('script')[0];x.parentNode.insertBefore(s,x);};if(document.readyState==='complete'){l();}else{w.addEventListener('load',l,false);}}})();
      </script>
    </>
  )}
</head>
<body>
  {!THIRD_PARTY && <div class="poc-banner">Proof of concept build. Analytics, Intercom and Bento tracking are switched off. The live site is at <a href="https://www.customersuccess.cx">customersuccess.cx</a>.</div>}
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={url('/')}>{SITE.name}</a>
      <nav class="nav" aria-label="Main">
        {NAV.map((item) => (
          <a href={url(item.href)} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <strong>{SITE.name}</strong> · Contact: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </div>
  </footer>
</body>
</html>
